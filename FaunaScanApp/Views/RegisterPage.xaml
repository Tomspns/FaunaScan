<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FaunaScanApp.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#020617">

    <ScrollView>
        <Grid>
            <!-- Decorative background element -->
            <BoxView 
                Color="#22C55E"
                Opacity="0.08"
                WidthRequest="300"
                HeightRequest="300"
                CornerRadius="150"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                TranslationY="-100"/>

            <VerticalStackLayout 
                Padding="28,50,28,40" 
                Spacing="20"
                VerticalOptions="Center">

                <!-- Header Section -->
                <VerticalStackLayout Spacing="8" Margin="0,0,0,10">
                    <Label 
                        Text="Créer un compte"
                        FontSize="32"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center"/>
                    <Label 
                        Text="Rejoignez FaunaScan dès maintenant"
                        FontSize="14"
                        TextColor="#94A3B8"
                        HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Form Card -->
                <Border 
                    BackgroundColor="#0F172A"
                    StrokeThickness="1"
                    Stroke="#1E293B"
                    Padding="24"
                    StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout Spacing="18">

                        <!-- Username Field -->
                        <VerticalStackLayout Spacing="8">
                            <Label 
                                Text="Pseudo"
                                FontSize="14"
                                TextColor="#94A3B8"/>
                            <Border 
                                BackgroundColor="#1E293B"
                                StrokeThickness="1"
                                Stroke="#334155"
                                Padding="16,14"
                                StrokeShape="RoundRectangle 12">
                                <Entry 
                                    Placeholder="Entrez votre pseudo"
                                    Text="{Binding Username}"
                                    TextColor="White"
                                    PlaceholderColor="#64748B"
                                    FontSize="16"
                                    Keyboard="Text"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Email Field -->
                        <VerticalStackLayout Spacing="8">
                            <Label 
                                Text="Email"
                                FontSize="14"
                                TextColor="#94A3B8"/>
                            <Border 
                                BackgroundColor="#1E293B"
                                StrokeThickness="1"
                                Stroke="#334155"
                                Padding="16,14"
                                StrokeShape="RoundRectangle 12">
                                <Entry 
                                    Placeholder="exemple@email.com"
                                    Text="{Binding Email}"
                                    TextColor="White"
                                    PlaceholderColor="#64748B"
                                    FontSize="16"
                                    Keyboard="Email"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Password Field -->
                        <VerticalStackLayout Spacing="8">
                            <Label 
                                Text="Mot de passe"
                                FontSize="14"
                                TextColor="#94A3B8"/>
                            <Border 
                                BackgroundColor="#1E293B"
                                StrokeThickness="1"
                                Stroke="#334155"
                                Padding="16,14"
                                StrokeShape="RoundRectangle 12">
                                <Entry 
                                    Placeholder="Minimum 8 caractères"
                                    IsPassword="True"
                                    Text="{Binding Password}"
                                    TextColor="White"
                                    PlaceholderColor="#64748B"
                                    FontSize="16"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Date of Birth Field -->
                        <VerticalStackLayout Spacing="8">
                            <Label 
                                Text="Date de naissance"
                                FontSize="14"
                                TextColor="#94A3B8"/>
                            <Border 
                                BackgroundColor="#1E293B"
                                StrokeThickness="1"
                                Stroke="#334155"
                                Padding="12,10"
                                StrokeShape="RoundRectangle 12">
                                <DatePicker 
                                    Date="{Binding BirthDate}"
                                    TextColor="White"
                                    FontSize="16"
                                    MinimumDate="1900-01-01"
                                    MaximumDate="2010-12-31"/>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Register Button with Glow Effect -->
                <Border
                    BackgroundColor="#22C55E"
                    StrokeThickness="0"
                    HeightRequest="56"
                    Margin="0,8,0,0"
                    StrokeShape="RoundRectangle 14">
                    <Border.Shadow>
                        <Shadow 
                            Brush="#22C55E"
                            Offset="0,4"
                            Radius="20"
                            Opacity="0.4"/>
                    </Border.Shadow>
                    <Button 
                        Text="S'inscrire"
                        Command="{Binding RegisterCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontSize="18"
                        FontAttributes="Bold"
                        VerticalOptions="Center"
                        HorizontalOptions="Fill"/>
                </Border>

                <!-- Terms Text -->
                <Label 
                    Text="En vous inscrivant, vous acceptez nos conditions d'utilisation et notre politique de confidentialité."
                    FontSize="12"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center"
                    Margin="0,4,0,0"/>

                <!-- Separator -->
                <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <BoxView 
                        Grid.Column="0" 
                        HeightRequest="1" 
                        Color="#334155" 
                        VerticalOptions="Center"/>
                    <Label 
                        Grid.Column="1" 
                        Text="ou" 
                        TextColor="#64748B" 
                        FontSize="14"
                        Margin="16,0"/>
                    <BoxView 
                        Grid.Column="2" 
                        HeightRequest="1" 
                        Color="#334155" 
                        VerticalOptions="Center"/>
                </Grid>

                <!-- Already have account -->
                <HorizontalStackLayout 
                    HorizontalOptions="Center" 
                    Spacing="6">
                    <Label 
                        Text="Déjà un compte ?"
                        TextColor="#94A3B8"
                        FontSize="15"
                        VerticalOptions="Center"/>
                    <Button 
                        Text="Se connecter"
                        Command="{Binding GoToLoginCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#22C55E"
                        FontSize="15"
                        FontAttributes="Bold"
                        Padding="0"/>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
