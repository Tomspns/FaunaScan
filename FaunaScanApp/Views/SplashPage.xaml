<ContentPage
    x:Class="FaunaScanApp.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#020617">

    <Grid>

        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="25">

            <Image
                x:Name="Logo"
                Source="logo.png"
                WidthRequest="400"
                HeightRequest="400"
                Opacity="0"
                Scale="0.5"/>

            <Label
                x:Name="TitleLabel"
                Text="FaunaScan"
                FontSize="40"
                TextColor="White"
                Opacity="0"/>

            <Label
                x:Name="Subtitle"
                Text="AI Animal Recognition"
                TextColor="#22C55E"
                Opacity="0"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>